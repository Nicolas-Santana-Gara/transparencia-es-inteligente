# Imagem usada pelo Vercel para servir o painel (Streamlit precisa de um servidor rodando).
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# A página do Streamlit vem marcada como inglês; sem isto o navegador "traduz" o painel e troca os textos.
RUN python -c "import pathlib, streamlit; p = pathlib.Path(streamlit.__file__).parent / 'static' / 'index.html'; p.write_text(p.read_text().replace('<html lang=\"en\">', '<html lang=\"pt-BR\" translate=\"no\">'))"

# O Vercel informa a porta na variável PORT
CMD ["sh", "-c", "streamlit run app.py --server.port ${PORT:-3000} --server.address 0.0.0.0 --server.headless true --browser.gatherUsageStats false"]
